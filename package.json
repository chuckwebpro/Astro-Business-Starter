{
  "name": "astro-business-starter",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/build-tokens.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/build-tokens.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "preverify": "node scripts/build-tokens.mjs",
    "verify": "astro check && prettier --check .",
    "format": "prettier --write .",
    "audit:lh": "lhci autorun",
    "audit:a11y": "start-server-and-test preview http://localhost:4321 \"pa11y-ci\"",
    "audit": "npm run audit:lh && npm run audit:a11y",
    "php:check": "node scripts/php-check.mjs",
    "php:install": "node scripts/php-install.mjs",
    "php:serve": "node scripts/php-serve.mjs",
    "php:dev": "npm run build && npm run php:install && npm run php:serve"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/lucide": "^1.2.136",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "astro-icon": "^1.2.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "^0.15.1",
    "pa11y-ci": "^4.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "start-server-and-test": "^2.1.5",
    "style-dictionary": "^4.4.0",
    "typescript": "^5.9.3"
  }
}
