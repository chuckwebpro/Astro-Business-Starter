---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import BlockHeader from './BlockHeader.astro';
import type { BlockProps } from './types';

export interface TeamMember {
  name: string;
  role: string;
  bio?: string;
  photo?: ImageMetadata;
}

interface Props extends BlockProps {
  items: TeamMember[];
  columns?: 2 | 3 | 4;
}

const {
  background = 'base',
  spacing = 'md',
  align = 'start',
  width = 'page',
  eyebrow,
  title,
  body,
  titleLevel = 2,
  items,
  columns = 4,
} = Astro.props;

const columnClass = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}[columns];
---

<Section background={background} spacing={spacing}>
  <Container width={width} align={align} gap="lg">
    <BlockHeader
      eyebrow={eyebrow}
      title={title}
      body={body}
      level={titleLevel}
      centered={align === 'center'}
    />

    <ul class:list={['grid w-full gap-8', columnClass]}>
      {
        items.map((member) => (
          <li class="flex flex-col gap-3">
            {member.photo ? (
              <Image
                src={member.photo}
                alt=""
                widths={[240, 480]}
                sizes="(max-width: 640px) 100vw, 25vw"
                loading="lazy"
                class="aspect-4/5 w-full rounded-lg object-cover"
              />
            ) : (
              <div class="bg-surface-muted aspect-4/5 w-full rounded-lg" aria-hidden="true" />
            )}

            <div class="flex flex-col gap-1">
              <Heading level={titleLevel === 2 ? 3 : 4} size="sm">
                {member.name}
              </Heading>
              <p class="text-ink-brand text-sm font-medium">{member.role}</p>
              {member.bio && <p class="text-ink-muted text-sm">{member.bio}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
