---
/** Shared heading cluster so every block introduces itself the same way. */
import Heading from '../ui/Heading.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  level?: 2 | 3;
  centered?: boolean;
}

const { eyebrow, title, body, level = 2, centered = false } = Astro.props;
---

{
  (eyebrow || title || body) && (
    <div class:list={['flex w-full flex-col gap-3', centered && 'items-center text-center']}>
      {eyebrow && (
        <p class="text-ink-brand text-sm font-semibold tracking-wide uppercase">{eyebrow}</p>
      )}
      {title && <Heading level={level}>{title}</Heading>}
      {body && <p class="max-w-reading text-ink-muted text-lg">{body}</p>}
    </div>
  )
}
