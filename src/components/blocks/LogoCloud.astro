---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import type { BlockProps } from './types';

export interface Logo {
  name: string;
  image?: ImageMetadata;
  href?: string;
}

interface Props extends Omit<BlockProps, 'body' | 'eyebrow' | 'titleLevel'> {
  items: Logo[];
  /** Small caption above the row, e.g. "Accredited by". */
  label?: string;
}

const { background = 'base', spacing = 'sm', width = 'page', items, label } = Astro.props;
---

<Section background={background} spacing={spacing}>
  <Container width={width} align="center" gap="md">
    {label && <p class="text-ink-muted text-sm font-semibold tracking-wide uppercase">{label}</p>}

    <ul class="flex w-full flex-wrap items-center justify-center gap-x-12 gap-y-8">
      {
        items.map((logo) => {
          const mark = logo.image ? (
            <Image
              src={logo.image}
              alt={logo.name}
              widths={[160, 320]}
              sizes="160px"
              loading="lazy"
              class="h-10 w-auto opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0"
            />
          ) : (
            <span class="text-ink-muted text-lg font-semibold">{logo.name}</span>
          );

          return <li>{logo.href ? <a href={logo.href}>{mark}</a> : mark}</li>;
        })
      }
    </ul>
  </Container>
</Section>
