---
/**
 * Only mounted when at least one analytics ID is set (see BaseLayout), so a
 * client with none ships zero bytes. Server log analytics is the baseline;
 * these tags exist for ad attribution.
 *
 * Nothing is render-blocking: tags load on idle or first interaction, and wait
 * for consent when a banner is configured.
 */
import { site } from '../../config/site';

const { ga4, gtm, metaPixel, bingUet, clarity } = site.analytics;
const needsConsent = site.consent === 'banner';
---

<script is:inline define:vars={{ ga4, gtm, metaPixel, bingUet, clarity, needsConsent }}>
  const loadTags = () => {
    if (window.__tagsLoaded) return;
    window.__tagsLoaded = true;

    const inject = (src) => {
      const script = document.createElement('script');
      script.src = src;
      script.async = true;
      document.head.appendChild(script);
    };

    if (ga4 || gtm) {
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('js', new Date());

      if (needsConsent) {
        window.gtag('consent', 'default', {
          ad_storage: 'denied',
          analytics_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
      }

      if (ga4) {
        inject('https://www.googletagmanager.com/gtag/js?id=' + ga4);
        window.gtag('config', ga4, { send_page_view: true });
      }

      if (gtm) {
        window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
        inject('https://www.googletagmanager.com/gtm.js?id=' + gtm);
      }
    }

    if (metaPixel) {
      /* prettier-ignore */
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      window.fbq('init', metaPixel);
      window.fbq('track', 'PageView');
    }

    if (bingUet) {
      window.uetq = window.uetq || [];
      /* prettier-ignore */
      !function(w,d,t,r,u){var f,n,i;w[u]=w[u]||[],f=function(){var o={ti:bingUet,enableAutoSpaTracking:false};o.q=w[u],w[u]=new UET(o),w[u].push('pageLoad')},n=d.createElement(t),n.src=r,n.async=1,n.onload=n.onreadystatechange=function(){var s=this.readyState;s&&s!=='loaded'&&s!=='complete'||(f(),n.onload=n.onreadystatechange=null)},i=d.getElementsByTagName(t)[0],i.parentNode.insertBefore(n,i)}(window,document,'script','//bat.bing.com/bat.js','uetq');
    }

    if (clarity) {
      /* prettier-ignore */
      (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src='https://www.clarity.ms/tag/'+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y)})(window,document,'clarity','script',clarity);
    }
  };

  const start = () => {
    if (window.requestIdleCallback) window.requestIdleCallback(loadTags, { timeout: 4000 });
    else setTimeout(loadTags, 1200);
  };

  if (needsConsent) {
    window.addEventListener('consent:granted', start, { once: true });
    if (localStorage.getItem('consent') === 'granted') start();
  } else {
    start();
    ['pointerdown', 'keydown'].forEach((event) =>
      window.addEventListener(event, start, { once: true, passive: true }),
    );
  }
</script>

{
  metaPixel && (
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        alt=""
        src={`https://www.facebook.com/tr?id=${metaPixel}&ev=PageView&noscript=1`}
      />
    </noscript>
  )
}
