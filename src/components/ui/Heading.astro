---
import type { HTMLAttributes } from 'astro/types';

export type HeadingLevel = 1 | 2 | 3 | 4 | 5 | 6;
export type HeadingSize = 'sm' | 'md' | 'lg' | 'xl' | 'display';

interface Props extends Omit<HTMLAttributes<'h2'>, 'class'> {
  /** Semantic level — set independently of visual size so document outline stays correct. */
  level?: HeadingLevel;
  size?: HeadingSize;
  balance?: boolean;
  class?: string;
}

const { level = 2, size, balance = true, class: className, ...rest } = Astro.props;

const Tag = `h${level}` as const;

const defaultSizeForLevel: Record<HeadingLevel, HeadingSize> = {
  1: 'display',
  2: 'xl',
  3: 'lg',
  4: 'md',
  5: 'sm',
  6: 'sm',
};

const sizes: Record<HeadingSize, string> = {
  sm: 'text-lg',
  md: 'text-xl',
  lg: 'text-2xl',
  xl: 'text-3xl',
  display: 'text-5xl',
};
---

<Tag
  class:list={[
    'font-semibold tracking-tight',
    sizes[size ?? defaultSizeForLevel[level]],
    balance && 'text-balance',
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
