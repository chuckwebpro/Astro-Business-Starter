{
  "font": {
    "sans": {
      "$value": "'Inter Variable', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    },
    "heading": {
      "$value": "'Inter Variable', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "text": {
    "xs": { "$value": "0.8125rem", "$type": "dimension" },
    "sm": { "$value": "0.9375rem", "$type": "dimension" },
    "base": { "$value": "1.0625rem", "$type": "dimension" },
    "lg": { "$value": "1.1875rem", "$type": "dimension" },
    "xl": { "$value": "clamp(1.25rem, 0.25vw + 1.19rem, 1.375rem)", "$type": "dimension" },
    "2xl": { "$value": "clamp(1.5rem, 0.6vw + 1.35rem, 1.875rem)", "$type": "dimension" },
    "3xl": { "$value": "clamp(1.875rem, 1.2vw + 1.58rem, 2.5rem)", "$type": "dimension" },
    "4xl": { "$value": "clamp(2.25rem, 2vw + 1.75rem, 3.25rem)", "$type": "dimension" },
    "5xl": { "$value": "clamp(2.75rem, 3.2vw + 1.95rem, 4.25rem)", "$type": "dimension" }
  },
  "leading": {
    "tight": { "$value": "1.15", "$type": "number" },
    "snug": { "$value": "1.35", "$type": "number" },
    "normal": { "$value": "1.6", "$type": "number" }
  },
  "tracking": {
    "tight": { "$value": "-0.02em", "$type": "dimension" },
    "normal": { "$value": "0em", "$type": "dimension" },
    "wide": { "$value": "0.08em", "$type": "dimension" }
  }
}
